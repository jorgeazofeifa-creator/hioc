{
  "$id": "action-f-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "accepted_manifest_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "attestation_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "client_disposition": {
          "enum": [
            "ABSENT",
            "EXACT_PREEXISTING",
            "PUBLISHED"
          ]
        },
        "client_identity": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "additionalProperties": false,
                  "properties": {
                    "dev": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "gid": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "ino": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "mode": {
                      "maxLength": 4,
                      "minLength": 1,
                      "pattern": "^[0-7]{4}$",
                      "type": "string"
                    },
                    "uid": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "dev",
                    "ino",
                    "uid",
                    "gid",
                    "mode"
                  ],
                  "type": "object"
                },
                "token": {
                  "items": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 9,
                  "minItems": 9,
                  "type": "array"
                }
              },
              "required": [
                "identity",
                "token"
              ],
              "type": "object"
            }
          ]
        },
        "client_path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/",
          "type": "string"
        },
        "client_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "current_consumer": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "durable_bundle_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "final_active": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "final_active_identity": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "additionalProperties": false,
              "properties": {
                "dev": {
                  "minimum": 0,
                  "type": "integer"
                },
                "gid": {
                  "minimum": 0,
                  "type": "integer"
                },
                "ino": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mode": {
                  "maxLength": 4,
                  "minLength": 1,
                  "pattern": "^[0-7]{4}$",
                  "type": "string"
                },
                "uid": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "dev",
                "ino",
                "uid",
                "gid",
                "mode"
              ],
              "type": "object"
            }
          ]
        },
        "final_environment_identity": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "additionalProperties": false,
              "properties": {
                "dev": {
                  "minimum": 0,
                  "type": "integer"
                },
                "gid": {
                  "minimum": 0,
                  "type": "integer"
                },
                "ino": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mode": {
                  "maxLength": 4,
                  "minLength": 1,
                  "pattern": "^[0-7]{4}$",
                  "type": "string"
                },
                "uid": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "dev",
                "ino",
                "uid",
                "gid",
                "mode"
              ],
              "type": "object"
            }
          ]
        },
        "final_environment_path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/",
          "type": "string"
        },
        "final_previous": {
          "const": "NONE"
        },
        "final_previous_identity": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "additionalProperties": false,
              "properties": {
                "dev": {
                  "minimum": 0,
                  "type": "integer"
                },
                "gid": {
                  "minimum": 0,
                  "type": "integer"
                },
                "ino": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mode": {
                  "maxLength": 4,
                  "minLength": 1,
                  "pattern": "^[0-7]{4}$",
                  "type": "string"
                },
                "uid": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "dev",
                "ino",
                "uid",
                "gid",
                "mode"
              ],
              "type": "object"
            }
          ]
        },
        "final_root_ctime_ns": {
          "oneOf": [
            {
              "const": "NONE"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ]
        },
        "historical": {
          "additionalProperties": false,
          "properties": {
            "construction_path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "d_evidence_directory": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "d_evidence_sha256": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "d_producer": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "d_source_sha256": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "e_evidence_directory": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "e_evidence_sha256": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "e_execution_consumer": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
