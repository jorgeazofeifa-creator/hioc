            "dev": {
              "minimum": 0,
              "type": "integer"
            },
            "gid": {
              "minimum": 0,
              "type": "integer"
            },
            "ino": {
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "maxLength": 4,
              "minLength": 1,
              "pattern": "^[0-7]{4}$",
              "type": "string"
            },
            "uid": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "dev",
            "ino",
            "uid",
            "gid",
            "mode"
          ],
          "type": "object"
        },
        "original_construction_path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/",
          "type": "string"
