                "dev": {
                  "minimum": 0,
                  "type": "integer"
                },
                "gid": {
                  "minimum": 0,
                  "type": "integer"
                },
                "ino": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mode": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "uid": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "dev",
                "ino",
                "uid",
                "gid",
                "mode"
              ],
              "type": "object"
            }
          },
          "required": [
            "e_execution_consumer",
            "e_evidence_directory",
            "e_evidence_sha256",
            "d_producer",
            "d_evidence_directory",
            "d_evidence_sha256",
            "d_source_sha256",
            "construction_path",
            "environment_identity",
