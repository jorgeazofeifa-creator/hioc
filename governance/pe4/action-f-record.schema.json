        "original_previous": {
          "const": "NONE"
        },
        "original_root_ctime_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "tree_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
