        "current_consumer",
        "durable_bundle_sha256",
        "final_active",
        "final_environment_identity",
        "final_environment_path",
        "final_previous",
        "historical",
        "original_active",
        "original_construction_identity",
        "original_construction_path",
        "original_previous",
        "tree_sha256",
        "original_root_ctime_ns",
        "final_root_ctime_ns",
        "final_active_identity",
        "final_previous_identity"
      ],
      "type": "object"
    },
    "error_code": {
      "enum": [
        "NONE",
        "INVALID",
        "MISMATCH",
        "CONFLICT",
        "UNAVAILABLE",
        "IO_FAILED",
        "LIMIT_EXCEEDED",
        "UNSTABLE",
        "LOCK_BUSY",
        "UNRESOLVED_TRANSACTION",
        "UNEXPECTED_ERROR"
      ]
    },
    "event": {
      "enum": [
        "PREPARED",
        "CLIENT_INTENT",
        "CLIENT_CONFIRMED",
        "ENVIRONMENT_INTENT",
        "ENVIRONMENT_CONFIRMED",
        "PREVIOUS_INTENT",
        "PREVIOUS_CONFIRMED",
        "ACTIVE_STAGE_INTENT",
        "ACTIVE_STAGE_CONFIRMED",
        "ACTIVE_SWITCH_INTENT",
        "ACTIVE_SWITCH_CONFIRMED",
        "POST_VERIFIED",
        "RESULT",
        "RESULT_REFERENCE",
        "COMMITTED"
      ]
    },
    "evidence_state": {
      "enum": [
        "NOT_CREATED",
        "UNCONFIRMED",
        "CONFIRMED"
      ]
    },
    "failure_stage": {
      "enum": [
        "ARGUMENTS",
        "TARGET",
        "SOURCE",
        "HANDOFF",
        "CONSTRUCTION",
        "PRECONDITIONS",
        "LOCK",
        "TRANSACTION",
        "JOURNAL",
        "CLIENT",
        "ENVIRONMENT",
        "PREVIOUS",
        "ACTIVE_STAGE",
        "ACTIVE_SWITCH",
        "POSTVALIDATION",
        "RESULT",
        "COMPLETION",
        "COMPLETE",
        "UNEXPECTED"
      ]
    },
    "previous_record_sha256": {
      "oneOf": [
        {
          "const": "NONE"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "publication_state": {
      "enum": [
        "NONE",
        "CLIENT_ONLY",
        "ENVIRONMENT_PUBLISHED",
        "ACTIVE_SWITCHED",
        "COMPLETE",
        "UNCERTAIN"
      ]
    },
    "record_type": {
      "const": "ACTION_F_RECORD"
    },
    "recovery_required": {
      "enum": [
        false,
        true
      ]
    },
    "result": {
      "enum": [
        "IN_PROGRESS",
        "PASS",
        "FAIL"
      ]
    },
    "result_sha256": {
      "oneOf": [
        {
          "const": "NONE"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "rollback_recommended": {
      "const": false
    },
    "schema_version": {
      "const": "2.0"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "transaction_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "bindings",
    "event",
    "evidence_state",
    "previous_record_sha256",
    "publication_state",
    "record_type",
    "recovery_required",
    "result_sha256",
    "rollback_recommended",
    "schema_version",
    "sequence",
    "transaction_id",
    "result",
    "error_code",
